# ============ 飞书应用（必填） ============
# 可运行 `room init` 自动创建 PersonalAgent 个人应用并写入以下两项
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret

# 任务负责人邮箱前缀（必填，自动加入所有会议参与者）
TASK_OWNER=zhangsan

# 会议室优先级列表，逗号分隔（必填）
ROOM_LIST=会议室A,会议室B,会议室C

# ============ 可选配置 ============
# 会议室层级 ID（配置后按层级+楼层顺序查找会议室）
# ROOM_LEVEL_ID=omb_xxxxxxxxxxxx
# 排除包含以下关键词的会议室
# ROOM_EXCLUDE_LIST=面试间,面谈舱
# 会议室最大容量限制（0 或不设为不限制）
# ROOM_SIZE=15

# 自动预订任务：dayOfWeek,startTime-endTime,frequency[:interval[:startDate]],participants(:分隔),title
# 多任务用 | 分隔
# TASK_FORMAT="fri,11:00:00-12:00:00,weekly,alice:bob,项目周会"

# 邮箱域名（参与者邮箱前缀 → 完整邮箱；解析非群 ID 参与者时必填）
EMAIL_DOMAIN=example.com

# 鉴权模式：auto（用户优先、应用兜底，默认）/ user / tenant
# FEISHU_AUTH_MODE=auto
# 用户凭证存储路径（默认 .cache/feishu-user-token.json）
# FEISHU_USER_TOKEN_PATH=.cache/feishu-user-token.json
# 用户授权 scope（空格分隔，默认见源码 defaultUserAuthScope）
# FEISHU_USER_AUTH_SCOPE=

# 自定义机器人 webhook（notify 命令）
# FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# FEISHU_BOT_WEBHOOK_SECRET=

# ============ NLP（book 命令自然语言解析，可选） ============
# OPENAI_API_KEY=sk-xxxx
# OPENAI_API_BASE=https://api.openai.com/v1
# MODEL=claude-4.6-opus

# ============ 其他 ============
# tianapi 节假日 API key（不设则跳过节假日过滤）https://www.tianapi.com/apiview/139
# TIANAPI_KEY=
# Sentry 错误上报 DSN。优先级：--sentry-dsn flag > 此环境变量 > release 二进制编译内置。
# 显式设空（SENTRY_DSN=）则完全禁用上报；不设置时 release 二进制会 fallback 到内置 DSN。
# SENTRY_DSN=
# TLS 证书校验开关：默认 1（跳过校验，兼容内网中间人代理环境）；设 0 恢复严格校验
# ROOM_TLS_INSECURE=1
